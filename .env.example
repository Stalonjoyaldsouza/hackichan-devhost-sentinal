# Sentinel configuration (placeholders only — never commit a real .env)
# Directory for demo audit databases created by `sentinel demo` when --db is not given.
SENTINEL_DATA_DIR=var
# Set to any value to disable ANSI colours in terminal output.
# NO_COLOR=1

# Advisory AI agents: auto | groq | offline | off  (auto = Groq if GROQ_API_KEY is set)
SENTINEL_AI=auto
# SENTINEL_AI_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=  # set in your shell; never commit a real key
