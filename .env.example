# Sentinel configuration (placeholders only — never commit a real .env)
# Directory for demo audit databases created by `sentinel demo` when --db is not given.
SENTINEL_DATA_DIR=var
# Set to any value to disable ANSI colours in terminal output.
# NO_COLOR=1

# Advisory AI agents: auto | groq | offline | off  (auto = Groq if GROQ_API_KEY is set)
SENTINEL_AI=auto
# SENTINEL_AI_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=  # set in your shell; never commit a real key
# Comma-separated fallbacks used when the main model is rate-limited (empty = none)
# SENTINEL_AI_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.3-70b-versatile
# Runtime SDK
# SENTINEL_AUDIT_PATH=/var/lib/sentinel/audit.db   # where guards write / health+watch read
# SENTINEL_COLLECTOR_TOKEN=                        # bearer token shared by apps and the collector
# SENTINEL_HEARTBEAT=0                             # disable the app heartbeat thread
# SENTINEL_APPROVER=human.owner                    # identity used by `sentinel sdk approve`
# SENTINEL_REQUIRE=1                               # fail instead of running unmonitored
